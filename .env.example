# Postgres connection string. Get a free instance from Neon (neon.tech) or
# Supabase (supabase.com) — both have generous free tiers that work well
# with Vercel. For quick local dev without a server, you can instead point
# prisma/schema.prisma's datasource provider back at "sqlite" and use
# DATABASE_URL="file:./dev.db".
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"
