# SQLite (default, zero-setup). For production/multi-terminal use, switch
# prisma/schema.prisma datasource provider to "postgresql" and set a
# postgres connection string here instead.
DATABASE_URL="file:./dev.db"

# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"
